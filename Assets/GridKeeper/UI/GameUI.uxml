<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="project://database/Assets/GridKeeper/UI/GameUI.uss" />
    <ui:VisualElement name="root" class="gk-root" picking-mode="Ignore">
        <ui:Label name="fps" text="60 FPS" class="fps hidden" picking-mode="Ignore" />
        <ui:VisualElement name="blackout-edge" class="blackout-edge" picking-mode="Ignore" />
        <ui:VisualElement name="hud" class="hud hidden" picking-mode="Ignore">
            <ui:VisualElement class="hud__row" picking-mode="Ignore">
                <ui:VisualElement name="budget" class="pill budget" picking-mode="Ignore">
                    <ui:Label text="BUDGET" class="pill__caption" picking-mode="Ignore" />
                    <ui:Label name="budget-value" text="$1300" class="pill__value" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="clock" class="pill clock" picking-mode="Ignore">
                    <ui:Label name="clock-day" text="DAY 1 OF 3" class="pill__caption" picking-mode="Ignore" />
                    <ui:Label name="clock-time" text="06:00" class="pill__value mono" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Button name="pause-button" class="round-button">
                    <ui:VisualElement class="pause-icon" picking-mode="Ignore">
                        <ui:VisualElement class="pause-icon__bar" picking-mode="Ignore" />
                        <ui:VisualElement class="pause-icon__bar" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement name="forecast" class="forecast" picking-mode="Ignore">
                <ui:VisualElement name="forecast-today" class="forecast__chip" picking-mode="Ignore">
                    <ui:VisualElement name="forecast-today-swatch" class="forecast__swatch" picking-mode="Ignore" />
                    <ui:Label name="forecast-today-text" text="Today: Clear skies" class="forecast__text" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="forecast-next" class="forecast__chip forecast__chip--next" picking-mode="Ignore">
                    <ui:VisualElement name="forecast-next-swatch" class="forecast__swatch" picking-mode="Ignore" />
                    <ui:Label name="forecast-next-text" text="Tomorrow: Cloudy" class="forecast__text" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="stats-card" class="card stats" picking-mode="Ignore">
                <ui:VisualElement class="status" picking-mode="Ignore">
                    <ui:VisualElement name="status-pill" class="status__pill" picking-mode="Ignore">
                        <ui:VisualElement class="status__dot" picking-mode="Ignore" />
                        <ui:Label name="status-text" text="READY" class="status__text" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label name="status-grade" text="GRADE --" class="status__grade mono" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="meter" picking-mode="Ignore">
                    <ui:VisualElement name="meter-fill" class="meter__fill" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="stats__legend" picking-mode="Ignore">
                    <ui:Label name="stat-supply" text="SUPPLY 0.0 MW" class="legend legend--supply mono" picking-mode="Ignore" />
                    <ui:Label name="stat-demand" text="DEMAND 0.0 MW" class="legend legend--demand mono" picking-mode="Ignore" />
                    <ui:Label name="stat-battery" text="STORED 0%" class="legend legend--battery mono" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="live-chart" class="chart chart--live" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="day-banner" text="Day 1 · Clear skies" class="day-banner hidden" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="placement-layer" class="placement-layer" picking-mode="Ignore">
            <ui:VisualElement name="placement-prompt" class="prompt" picking-mode="Ignore">
                <ui:VisualElement name="prompt-dot" class="prompt__dot" picking-mode="Ignore" />
                <ui:Label name="prompt-text" class="prompt__text" text="Move your phone slowly over a table" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="build-layer" class="build-layer hidden" picking-mode="Ignore">
            <ui:VisualElement name="tutorial-hint" class="tutorial-hint hidden">
                <ui:Label text="KEEPER'S NOTES" class="tutorial-hint__eyebrow" picking-mode="Ignore" />
                <ui:Label name="tutorial-text" text="Hint" class="tutorial-hint__text" picking-mode="Ignore" />
                <ui:Button name="tutorial-skip" text="Skip tutorial" class="tutorial-hint__skip" />
            </ui:VisualElement>
            <ui:Button name="start-button" text="Start the shift" class="primary-button start-floating hidden" />
            <ui:Label name="build-hint" class="build-hint" text="Pick a source, then tap a tile" picking-mode="Ignore" />
            <ui:VisualElement name="tray" class="tray">
                <ui:Button name="tool-solar" class="tool tool--solar">
                    <ui:VisualElement class="tool__icon icon-solar" picking-mode="Ignore" />
                    <ui:Label text="Solar" class="tool__name" picking-mode="Ignore" />
                    <ui:Label name="tool-solar-cost" text="$150" class="tool__cost" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button name="tool-wind" class="tool tool--wind">
                    <ui:VisualElement class="tool__icon icon-wind" picking-mode="Ignore">
                        <ui:VisualElement class="icon-wind__head" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label text="Wind" class="tool__name" picking-mode="Ignore" />
                    <ui:Label name="tool-wind-cost" text="$200" class="tool__cost" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button name="tool-battery" class="tool tool--battery">
                    <ui:VisualElement class="tool__icon icon-battery" picking-mode="Ignore" />
                    <ui:Label text="Battery" class="tool__name" picking-mode="Ignore" />
                    <ui:Label name="tool-battery-cost" text="$120" class="tool__cost" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button name="tool-remove" class="tool tool--remove">
                    <ui:VisualElement class="tool__icon icon-remove" picking-mode="Ignore" />
                    <ui:Label text="Remove" class="tool__name" picking-mode="Ignore" />
                    <ui:Label text="50% back" class="tool__cost" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="briefing" class="overlay hidden">
            <ui:VisualElement class="sheet">
                <ui:VisualElement class="story__top">
                    <ui:Label name="briefing-eyebrow" text="A MESSAGE FROM THE COUNCIL" class="sheet__eyebrow" />
                    <ui:Button name="briefing-skip" text="Skip" class="story__skip" />
                </ui:VisualElement>
                <ui:Label name="briefing-title" text="Welcome, Keeper." class="sheet__title" />
                <ui:Label name="briefing-body" text="" class="sheet__body" />
                <ui:VisualElement name="briefing-visual" class="story__visual" />
                <ui:VisualElement name="briefing-forecast" class="briefing-forecast" />
                <ui:VisualElement name="briefing-dots" class="story__dots" picking-mode="Ignore" />
                <ui:Button name="plan-button" text="Plan the grid" class="primary-button" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="pause" class="overlay hidden">
            <ui:VisualElement class="sheet sheet--compact">
                <ui:Label text="Paused" class="sheet__title" />
                <ui:Label text="The town waits for you." class="sheet__body" />
                <ui:Button name="resume-button" text="Resume" class="primary-button" />
                <ui:Button name="restart-button" text="Restart shift" class="secondary-button" />
                <ui:Button name="replay-tutorial-button" text="Replay tutorial" class="secondary-button" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="results" class="overlay hidden">
            <ui:VisualElement class="sheet">
                <ui:Label text="SHIFT COMPLETE" class="sheet__eyebrow" />
                <ui:VisualElement class="results__head">
                    <ui:Label name="results-grade" text="A" class="grade" />
                    <ui:VisualElement class="results__headline">
                        <ui:Label name="results-share" text="94% of demand met" class="sheet__title" />
                        <ui:Label name="results-note" text="Brightwater slept soundly." class="sheet__body" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="results-chart" class="chart chart--results" picking-mode="Ignore" />
                <ui:VisualElement class="chart-key" picking-mode="Ignore">
                    <ui:Label text="Solar" class="key key--solar" />
                    <ui:Label text="Wind" class="key key--wind" />
                    <ui:Label text="Stored" class="key key--battery" />
                    <ui:Label text="Demand" class="key key--demand" />
                    <ui:Label text="Dark" class="key key--dark" />
                </ui:VisualElement>
                <ui:VisualElement class="results__rows">
                    <ui:VisualElement class="row">
                        <ui:Label text="Energy delivered" class="row__label" />
                        <ui:Label name="results-delivered" text="0" class="row__value mono" />
                    </ui:VisualElement>
                    <ui:VisualElement class="row">
                        <ui:Label text="Hours in the dark" class="row__label" />
                        <ui:Label name="results-blackout" text="0" class="row__value mono" />
                    </ui:VisualElement>
                    <ui:VisualElement class="row">
                        <ui:Label text="Energy wasted" class="row__label" />
                        <ui:Label name="results-wasted" text="0" class="row__value mono" />
                    </ui:VisualElement>
                    <ui:VisualElement class="row">
                        <ui:Label text="Money earned" class="row__label" />
                        <ui:Label name="results-earned" text="0" class="row__value mono" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="again-button" text="Play again" class="primary-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
